# Скопируйте в .env и заполните. Файл .env в репозиторий не попадает.

# --- Каталог ---------------------------------------------------------------
# Папка базы знаний и legacy-файл. Текущую версию каталога называет указатель
# <папка KB_PATH>/current (EPIC 4); без указателя бот читает этот файл.
KB_PATH=data/kb/products.jsonl
STORAGE_PATH=data/vdm.sqlite3

# Импорт выгрузки на проверку: python run.py import-1c --file <выгрузка>.xlsx
# База импорта отдельная от STORAGE_PATH, загруженные файлы хранятся по sha256.
CATALOG_DB_PATH=data/catalog.sqlite3
UPLOADS_DIR=data/uploads
IMPORT_MAX_MB=50

# Сопоставление позиции с каталогом: код 1С → название → артикул поставщика →
# похожее название. Пороги — доля общих триграмм названия, от 0 до 1.
# Похожее название по умолчанию только предлагается менеджеру (MATCHED_REVIEW):
# в каталоге много почти одинаковых товаров («Обруч 60 см / 80 см»).
# Автовыбор включается только значением 1/true/yes.
MATCH_AUTO_ENABLED=0
MATCH_AUTO_THRESHOLD=0.85
# Ниже — NOT_FOUND.
MATCH_REVIEW_THRESHOLD=0.60
# Если второй кандидат ближе к лучшему, чем на эту величину, — AMBIGUOUS.
MATCH_AMBIGUITY_MARGIN=0.05

# Версии каталога: python run.py catalog init | approve ID | versions | rollback ВЕРСИЯ.
# Без --force утверждение и откат останавливаются, если исчезает больше доли товаров
# или цена меняется у большей доли существующих товаров.
CATALOG_MAX_REMOVED_SHARE=0.10
CATALOG_MAX_PRICE_CHANGED_SHARE=0.30
# Как часто виджет и Telegram сверяют указатель (и всегда — перед ходом).
CATALOG_RELOAD_SECONDS=30

# --- Ядро: закупка, заказы клиентов, предзаказы, Core API (docs/CORE.md) -----
# База ядра. Пусто — файл STORAGE_PATH: предзаказ несёт контакты клиента, и
# удаление данных по требованию субъекта проходит в одном файле.
CORE_DB_PATH=
# Загрузка готового заказа клиента: .xlsx, .docx, .pdf, .csv. Файлы — в UPLOADS_DIR/orders.
ORDER_UPLOAD_MAX_MB=20
# Отчёты менеджеру о предзаказах (Excel), пока CRM недоступна. Содержат контакты.
PREORDERS_DIR=data/preorders
# Ключ серверных адаптеров Core API (заголовок X-Core-Api-Key) и ключ ручных операций
# менеджера (X-Manager-Key). Пусто — эти возможности выключены и отвечают 503.
# НАСТОЯЩИЕ КЛЮЧИ СЮДА НЕ ВПИСЫВАТЬ — только в .env.
CORE_API_KEY=
CORE_MANAGER_KEY=

# --- Модель ----------------------------------------------------------------
# Провайдеров два. Cloud.ru — то, где всё будет работать у заказчика. OpenRouter —
# то, где диалог можно проверить с машины разработки, когда российское облако
# с неё не открывается.
#   auto       — сначала Cloud.ru, при отказе OpenRouter (по умолчанию)
#   cloudru    — только Cloud.ru
#   openrouter — только OpenRouter
# Проверка по шагам: python run.py llm
LLM_PROVIDER=auto

# Ключ сервисного аккаунта Cloud.ru. Пока пусто — бот работает без модели:
# отвечает поиском по каталогу, корзина и заказ при этом полностью рабочие.
# НАСТОЯЩИЕ КЛЮЧИ СЮДА НЕ ВПИСЫВАТЬ: этот файл лежит в публичном репозитории.
CLOUDRU_API_KEY=
CLOUDRU_BASE_URL=https://foundation-models.api.cloud.ru/v1
CLOUDRU_MODEL=deepseek-ai/DeepSeek-V4-Flash

# Ключ OpenRouter — openrouter.ai, раздел Keys. Вписывается в .env, не сюда.
# Запасной провайдер, когда Cloud.ru недоступен. Модель — DeepSeek: qwen3-235b
# стоял здесь до 02.09 и путал формулировки пунктов приказов, приписывая
# школьный пункт садовскому приказу (разбор в баги0209.мд).
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=deepseek/deepseek-chat-v3-0324

LLM_TIMEOUT_SECONDS=60
# 1200 не хватало на спецификацию из десятка позиций — ответ обрывался на
# середине таблицы.
LLM_MAX_TOKENS=2000

# Рубли за миллион токенов — по прайсу провайдера. Нужны только для журнала:
# в него пишется стоимость каждого хода, и по ней считается цена сценария.
# Значения ниже — Cloud.ru за DeepSeek-V4-Flash на 01.09.2026.
CLOUDRU_PRICE_IN=18.53
CLOUDRU_PRICE_OUT=37.08
OPENROUTER_PRICE_IN=0
OPENROUTER_PRICE_OUT=0

# --- Каналы ----------------------------------------------------------------
# Токен бота от @BotFather. НАСТОЯЩИЙ ТОКЕН СЮДА НЕ ВПИСЫВАТЬ — только в .env на машине,
# где работает бот и сервер Mini App (оба процесса читают один .env).
# Прежнее имя TELEGRAM_TOKEN больше не читается: строку с ним из .env удалите.
# Проверка без запуска бота: python run.py telegram --check
TELEGRAM_BOT_TOKEN=
# Транзит до api.telegram.org — нужен там, где сеть сервера до Telegram не доходит.
# Формат: socks5://логин:пароль@хост:1080 либо http://хост:3128. Транзит передаёт
# уже зашифрованный трафик и переписки не видит. Пусто — бот идёт к Telegram напрямую.
# Проверка: python run.py telegram --check
TELEGRAM_PROXY=
# Публичный HTTPS-адрес Mini App: https://<хост>/miniapp — сервер `python run.py widget`
# за HTTPS-прокси. Задан — бот ставит кнопку меню «Приложение». Вход в Mini App
# проверяется подписью по TELEGRAM_BOT_TOKEN, поэтому токен нужен и серверу Mini App.
# Локально оставьте пустым: Telegram не открывает http://127.0.0.1:8000/miniapp, и для
# адреса без https:// бот кнопку не публикует. Смена домена — только эта строка.
TELEGRAM_MINIAPP_URL=
# Кнопка «Продолжить в Telegram» в виджете: адрес бота вида https://t.me/имя_бота.
# Посетитель уносит корзину из виджета в чат: /start <сессия сайта> переносит её.
# Пусто — кнопки в виджете не будет.
TELEGRAM_BOT_URL=
# Токен MAX выдаётся после верификации юрлица — до этого канал выключен.
MAX_TOKEN=
SITE_URL=https://vdm.ru
MANAGER_CONTACT=+7 (495) 646-01-40, elti@vdm.ru
# Условия доставки на сайте: бот отвечает ссылкой и не считает стоимость сам.
DELIVERY_URL=https://vdm.ru/usloviya-raboty-/dostavka/
# Сумма, с которой заказчик оформляет доставку. Это не порог заказа: заявка уходит
# менеджеру при любой сумме, ниже порога добавляется строка про самовывоз.
MIN_DELIVERY_RUB=3000

# --- Автотест сценариев: python run.py scenarios (ЗАПУСК_VSCODE.md, §14 H) ---
# Ключи приложения ТЕСТОВОГО пользовательского аккаунта с https://my.telegram.org — не бота.
# Настоящие значения — только в .env.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Имя бота без @; пусто — узнаётся по TELEGRAM_BOT_TOKEN.
QA_BOT_USERNAME=
# Модель тестировщика и судьи на OpenRouter (ключ — OPENROUTER_API_KEY).
QA_MODEL=deepseek/deepseek-chat-v3-0324
# Модель судьи; пусто — та же, что у тестировщика.
QA_JUDGE_MODEL=
# Telegram id тестового аккаунта (через запятую). Читает бот: предзаказы этого аккаунта менеджеру не уходят.
QA_USER_IDS=

# --- Куда уходит заказ -----------------------------------------------------
# jsonl — локальный файл (по умолчанию, ничего не требует)
# smtp — письмо менеджерам со спецификацией во вложении
# google_sheets — таблица вместо CRM, пока нет доступа к CRM
# bitrix24 — заглушка, включится с вебхуком заказчика
ORDER_SINK=jsonl
ORDERS_JSONL_PATH=data/orders.jsonl
# Спецификация заказа в Excel — то, что менеджер заводит в 1С руками, пока
# интеграции нет. Пишется всегда, рядом с jsonl.
ORDERS_XLSX_DIR=data/orders
GOOGLE_SHEETS_ID=
GOOGLE_CREDENTIALS_FILE=secrets/google-service-account.json

# Заявка письмом (ORDER_SINK=smtp). Ящик-отправитель и пароль вписываются только
# здесь, на сервере: в git они не попадают. Порт 465 — SSL, 587 — STARTTLS.
# Письмо не единственная копия заказа: jsonl и Excel пишутся в любом случае.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ORDER_EMAIL_TO=

# --- Фотографии товаров ----------------------------------------------------
# В выгрузке 1С изображений нет, они добираются со страниц сайта и попадают
# в базу знаний (поле images в products.jsonl).
# Весь каталог:  python run.py media
# Проба:         python run.py media --cards 20
# Прогрев по разделу: python run.py media --listing <адрес списка> --cards 0
MEDIA_ENABLED=1
# Пауза между запросами к сайту. Не поднимать: vdm.ru — рабочий сайт.
MEDIA_MIN_INTERVAL=1.0
# robots.txt написан для поисковых роботов, бот делается для владельца сайта.
MEDIA_RESPECT_ROBOTS=0
# Только латиница: кириллица в заголовке HTTP роняет запрос.
MEDIA_USER_AGENT=

# --- Журнал диалогов (сырьё для доработки промптов) -------------------------
# Пишется по суткам в JSONL. Персональные данные обезличиваются перед записью,
# ответы на вопросы о контактах не пишутся вовсе.
# Просмотр: python run.py dialogs --last 20
# Выгрузка: python run.py dialogs --last 50 --export dialogs.md
DIALOG_LOG_ENABLED=1
DIALOG_LOG_PATH=data/dialogs
DIALOG_LOG_MASK_PDN=1

# --- Виджет ----------------------------------------------------------------
# Домены, которым разрешено обращаться к виджету. Боевой сайт добавляется сюда.
WIDGET_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
WIDGET_HOST=0.0.0.0
WIDGET_PORT=8000
