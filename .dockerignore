# Что не уходит в контекст сборки. Без этого файла docker отправляет демону весь
# каталог проекта — вместе с data/media (1,4 ГБ), выгрузками 1С и .venv, и сборка
# на ВМ с 20 ГБ диска упирается в место раньше, чем ставится первый пакет.

# Данные и секреты: в контейнер не копируются, каталог data монтируется томом.
.env
.env.*
!.env.example
data/
secrets/
*.pdf

# Окружение разработки
.venv/
.git/
.github/
.vscode/
.claude/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
src/*.egg-info/

# Тесты, документы, черновики: образу не нужны
tests/
docs/
*.md
*.мд
*.txt
# Промпты агентов — часть исходников, без них бот не отвечает. Правила выше
# рассчитаны на корень контекста, но исключение пишем явно.
!src/agent/prompts/*.md
*.docx
*.xlsx
deploy/
Dockerfile
docker-compose.yml
.dockerignore
